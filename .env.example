DATABASE_URL="file:./dev.db"
AUTH_SECRET="dəyişdirin — `npx auth secret` ilə yaradın"

# Auth.js v5: `next start` (NODE_ENV=production) rejimində host başlığı default
# olaraq etibarsız sayılır və giriş `UntrustedHost` ilə dayanır. Lokal / öz
# serverində işlədikdə bu bayraq məcburidir (Vercel-də avtomatik qoyulur).
AUTH_TRUST_HOST=true

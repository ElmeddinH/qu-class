{
  "name": "qu-class",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "free-port": "node scripts/free-port.mjs 3000",
    "docs:assets": "node scripts/copy-swagger.mjs",
    "predev": "npm run free-port && npm run docs:assets",
    "dev": "next dev -p 3000",
    "predev:debug": "npm run free-port && npm run docs:assets",
    "dev:debug": "NODE_OPTIONS=--inspect next dev -p 3000",
    "prebuild": "npm run docs:assets",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "git:init": "node scripts/git.mjs init",
    "git:commit": "node scripts/git.mjs commit",
    "git:log": "node scripts/git.mjs log",
    "git:audit": "node scripts/git-audit.mjs",
    "git:push": "node scripts/git-push.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
